# Токен бота. Получить: в Telegram открыть @BotFather -> /newbot
BOT_TOKEN=123456:ВСТАВЬ_СЮДА_ТОКЕН

# Твой Telegram ID (число). Узнать: запусти бота и отправь ему команду /id
# Несколько админов — через запятую: 111111111,222222222
ADMIN_IDS=

# Панель управления в браузере. Впиши адрес, по которому открывается твой сервер,
# например http://203.0.113.10:8080 — бот будет присылать ссылку для входа по команде /panel.
# Если запускаешь бота на своём компьютере, оставь как есть.
PANEL_URL=http://localhost:8080
# Порт панели. 0 — выключить панель.
PANEL_PORT=8080
